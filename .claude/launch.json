{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd frontend && PATH=/usr/local/bin:$PATH /usr/local/bin/npm run dev -- --port 5173 --strictPort"
      ],
      "port": 5173
    },
    {
      "name": "backend",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd backend && .venv/bin/uvicorn app.main:app --port 8000 --reload"
      ],
      "port": 8000
    }
  ]
}
